{
  "name": "dunetrace",
  "version": "0.7.1",
  "description": "The runtime reliability layer for AI agents.",
  "author": "Dunetrace UG (haftungsbeschränkt) <vikas@dunetrace.com>",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agents",
    "observability",
    "llm",
    "monitoring"
  ],
  "homepage": "https://github.com/dunetrace/dunetrace",
  "repository": {
    "type": "git",
    "url": "https://github.com/dunetrace/dunetrace"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "require": "./dist/otel.js",
      "default": "./dist/otel.js"
    },
    "./integrations/otel": {
      "types": "./dist/integrations/otel.d.ts",
      "require": "./dist/integrations/otel.js",
      "default": "./dist/integrations/otel.js"
    },
    "./integrations/otel-receiver": {
      "types": "./dist/integrations/otel-receiver.d.ts",
      "require": "./dist/integrations/otel-receiver.js",
      "default": "./dist/integrations/otel-receiver.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:vercel-ai": "tsx examples/vercel_ai_agent.ts",
    "example:vercel-ai:loop": "SCENARIO=tool_loop tsx examples/vercel_ai_agent.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": ">=0.57.0",
    "@opentelemetry/resources": ">=1.30.0",
    "@opentelemetry/sdk-trace-base": ">=1.30.0",
    "ai": ">=7.0.0",
    "better-sqlite3": ">=11.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.57.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-grpc": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.20.0",
    "ai": "^7.0.4",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  },
  "overrides": {
    "postcss": ">=8.5.23"
  }
}
