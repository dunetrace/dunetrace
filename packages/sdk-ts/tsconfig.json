{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    // ES2021 for WeakRef + FinalizationRegistry, which the exit-flush registry
    // in client.ts uses to avoid pinning every client for the life of the
    // process. `target` stays ES2020, so the emitted syntax is unchanged —
    // this only widens the type surface, and package.json already requires
    // Node >= 22, where both have shipped since v14.6/v14.
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
