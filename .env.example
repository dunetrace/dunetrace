# Copy this file to .env and fill in your values.
# docker compose will load .env automatically.

# Shared
DATABASE_URL=postgresql://dunetrace:dunetrace@postgres:5432/dunetrace
LOG_LEVEL=INFO

# Ingest service
# AUTH_MODE: dev (no API key needed) | prod (requires api_keys table entries)
AUTH_MODE=dev
# Admin key for POST /v1/keys (generate API keys). Leave blank to disable.
# ADMIN_API_KEY=
# Token for internal service-to-service calls (leave blank in dev)
# INTERNAL_TOKEN=
# Per-IP rate limit: requests per minute (default: 60)
# RATE_LIMIT_REQUESTS=60
# Global rate limit across all IPs: requests per minute (default: 600)
# RATE_LIMIT_RPM=600
# Max events per ingest batch (default: 500)
# MAX_BATCH_SIZE=500

# Detector service
# Seconds between detector poll cycles (default: 5)
POLL_INTERVAL=5
# Treat runs with no new events for N seconds as stalled (default: 90)
STALL_TIMEOUT_SECS=90
# Runs processed per poll cycle (default: 100)
BATCH_SIZE=100
# Parallel run-processing goroutines (default: 8)
# DETECTOR_CONCURRENCY=8
# Horizontal sharding: total shard count (default: 1 = no sharding)
# SHARD_COUNT=1
# This replica's shard index, 0-based (default: 0)
# SHARD_INDEX=0
# Path to detector threshold overrides (default: detectors.yml in repo root)
# DETECTORS_YML=detectors.yml

# Alerts service (leave blank to run with no destinations)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_CHANNEL=#agent-alerts
# SLACK_MIN_SEVERITY=HIGH           # options: LOW | MEDIUM | HIGH | CRITICAL (default: HIGH)
# WEBHOOK_URL=https://your-endpoint.example.com/alerts
# WEBHOOK_SECRET=your-hmac-secret
# URL used in Slack alert "View Run" links — set to your dashboard address
# DASHBOARD_URL=http://localhost:3000
# Suppress duplicate alerts for the same (agent, failure_type) within N seconds (default: 3600)
# ALERT_DEDUP_WINDOW=3600
# Max delivery attempts before giving up (default: 3)
# MAX_RETRIES=3
# Backoff multiplier between retries in seconds (default: 2.0)
# RETRY_BACKOFF=2.0
# Weekly digest (Monday 9am UTC). Set DIGEST_ENABLED=true to enable.
# DIGEST_ENABLED=false
# Digest day of week: 0=Monday … 6=Sunday (default: 0)
# DIGEST_DAY=0
# Digest hour in UTC (default: 9)
# DIGEST_HOUR=9

# Customer API
# Max results per page (default: 50)
# PAGE_SIZE_DEFAULT=50
# Hard cap on page size (default: 500)
# PAGE_SIZE_MAX=500
# Secret for validating signed policy payloads (leave blank in dev)
# POLICY_SIGNING_SECRET=
# Signing secret for Slack interactive payloads
# SLACK_SIGNING_SECRET=

# LLM for explain endpoint (Anthropic preferred; falls back to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# GitHub integration — enables "Open PR" fix path
# Legacy single-repo path (fallback when no per-org GitHub App installation exists):
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/repo
# GITHUB_BASE_BRANCH=main

# Per-org GitHub App (recommended — see docs/integrations/github-app.md):
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_SLUG=your-app-slug

# SDK examples (optional)
# OPENAI_API_KEY=sk-...
