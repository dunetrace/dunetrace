# Copy this file to .env and fill in your values.
#
# IMPORTANT — COMPOSE DOES NOT LOAD THIS FILE INTO CONTAINERS. Neither
# docker-compose.yml nor docker-compose.ghcr.yml has an `env_file:` directive:
# compose reads .env only to INTERPOLATE the ${VAR} references inside those
# files. A variable set here therefore reaches a running service only if that
# service's `environment:` block names it.
#
# Every knob below is wired to the service(s) whose config.py actually reads it.
# If you add a new one, add the matching `NAME: ${NAME:-<default>}` line to BOTH
# compose files or it is silently inert — which is exactly what happened to
# POLICY_SIGNING_SECRET: it was documented here and in docs/policies.md, set by
# operators, read by nothing, and every remote enforcing policy stayed
# downgraded to log-only.
#
# Running a service OUTSIDE Docker is different: each service's config.py reads
# ./.env itself at import time, so there every variable here applies.

# Shared
# Compose sets DATABASE_URL per service (docker-compose.prod.yml threads
# POSTGRES_PASSWORD into it); this value is for running a service outside Docker.
DATABASE_URL=postgresql://dunetrace:dunetrace@postgres:5432/dunetrace
LOG_LEVEL=INFO

# Deployment identity and authentication — read by EVERY service.
# ENV: dev | prod. AUTH_MODE: dev (no API key needed; every request is an admin
# of the default org) | prod (every endpoint requires an api_keys row).
# Both compose files default both to `dev` for the loopback-only quickstart
# (every published port is bound to 127.0.0.1). The service code itself
# defaults AUTH_MODE to `prod`, so dev mode is always an explicit opt-in.
# For a real deployment use the production override, which pins ENV=prod and
# AUTH_MODE=prod on every service as literals (these two lines cannot reopen
# it) — see docs/operations.md, section "Deploying". Every service refuses to
# start with ENV=prod and AUTH_MODE=dev. If you override here instead, set BOTH.
ENV=dev
AUTH_MODE=dev
# Postgres password. Required (no default) by docker-compose.prod.yml, which
# threads it into every DATABASE_URL; the quickstart uses `dunetrace`.
# POSTGRES_PASSWORD=
# Admin key for the ingest service's POST /v1/keys — the bootstrap that mints
# the first (admin-scoped) API key on a fresh install — and for the /admin/*
# endpoints. Leave blank to disable both.
# ADMIN_API_KEY=
# Token for internal service-to-service calls (leave blank in dev)
# INTERNAL_TOKEN=
# Per-IP rate limit: requests per minute (default: 60)
# RATE_LIMIT_REQUESTS=60
# Global rate limit across all IPs: requests per minute (default: 600)
# RATE_LIMIT_RPM=600
# Max events per ingest batch (default: 500)
# MAX_BATCH_SIZE=500
# Max request body for POST /v1/ingest and /v1/deploy, in bytes (default: 10 MiB).
# Larger bodies get 413 before they are buffered or parsed. The OTLP receiver has
# its own cap, OTLP_MAX_BODY_BYTES (same default). See docs/operations.md.
# INGEST_MAX_BODY_BYTES=10485760
# Build identity reported by every service's dunetrace_build_info{service,version}
# metric (APP_VERSION, else GIT_COMMIT, else the package version). Set one in deploy.
# APP_VERSION=
# Every service serves GET /ready (readiness) and GET /metrics (Prometheus); the
# two APIs on their own port, the workers on a METRICS_PORT of their own. The
# compose files pin those ports per service (9101-9105) for their healthchecks;
# the per-service lines below only matter when running a worker outside Docker.
# 0 disables a worker's server. See docs/operations.md, section "Observability".

# Detector service
# POLL_INTERVAL and BATCH_SIZE are the DETECTOR's knobs: the alerts and semantic
# workers read the same two names but pin their own values in the compose files,
# so setting these does not retune all three workers at once.
# Seconds between detector poll cycles (default: 5)
POLL_INTERVAL=5
# Treat runs with no new events for N seconds as stalled (default: 90)
STALL_TIMEOUT_SECS=90
# Runs processed per poll cycle (default: 100)
BATCH_SIZE=100
# Parallel run-processing goroutines (default: 8)
# DETECTOR_CONCURRENCY=8
# Horizontal sharding: total shard count (default: 1 = no sharding).
# Applies to BOTH the detector and the alerts worker — same scheme, same names.
# SHARD_COUNT=1
# This replica's shard index, 0-based (default: 0)
# SHARD_INDEX=0
# Re-scan overlap for the detector's poll watermark, in seconds (default: 3600).
# The watermark is what bounds run discovery to recent events instead of the whole
# retention window. Must be >= STALL_TIMEOUT_SECS or the worker refuses to start.
# See docs/architecture.md's "Poll watermark".
# WATERMARK_GRACE_SECS=3600
# Path to detector threshold overrides, read by the DETECTOR service
# (default: /app/detectors.yml — where docker-compose mounts it)
# DETECTOR_CONFIG=/app/detectors.yml
# Port for the detector's /metrics, /ready and /health (default: 9101; 0 disables)
# METRICS_PORT=9101
# Directory scanned at startup for Python-class custom detectors
# (default: ~/.dunetrace/detectors/ — see docs/detectors.md)
# DUNETRACE_CUSTOM_DETECTORS_PATH=~/.dunetrace/detectors

# Event retention (ingest service)
# Drop event partitions older than N days. Runs at startup then daily.
# See docs/operations.md. Default 90.
# EVENT_RETENTION_DAYS=90

# processed_runs retention (detector service)
# Pruned by absence of events, not by age — see db.py::prune_processed_runs.
# (There is no PROCESSED_RUNS_RETENTION_DAYS: it bounded the scan by
# processed_at, which is refreshed on re-analysis, so it never expired rows
# whose events had aged out. It was removed rather than left as a no-op knob.)
# Rows per delete batch (default: 10000)
# PRUNE_BATCH_SIZE=10000

# Semantic evaluation worker (Tier 2, LLM-based — OFF by default)
# See docs/semantic-evaluation.md. Requires an LLM key below.
# SEMANTIC_WORKER_ENABLED=false
# Which provider the evaluators build by default: openai | anthropic | mistral
# mistral keeps evaluation inside a European provider. There is no cross-provider
# fallback: if the selected provider fails, the evaluation fails rather than
# quietly retrying somewhere else, and an unrecognised value here is a startup
# error rather than a silent default to OpenAI. See docs/integrations/mistral.md.
# SEMANTIC_LLM_PROVIDER=openai
# Second opinions (semantic-evaluators.yml's require_second_opinion) confirm a
# HIGH finding with a *different* model, by default a different vendor. With
# SEMANTIC_LLM_PROVIDER=mistral that would send the run text to a US API on
# exactly the findings that matter most, so it is suppressed in favour of a
# second Mistral model. Set this to true to allow the cross-vendor second
# opinion anyway — for a deployment that chose Mistral on cost, not residency.
# SEMANTIC_ALLOW_CROSS_PROVIDER_SECOND_OPINION=false
# Evaluator LLM key for the selected provider. The SDK's Mistral
# auto-instrumentation reads your app's own client credentials, not this.
# MISTRAL_API_KEY=
# Per-evaluator model override. Blank = the provider's cost-conscious default.
# HALLUCINATION_MODEL=
# TASK_COMPLETION_MODEL=
# TASK_UNDERSTANDING_FAILURE_MODEL=
# OFF_TOPIC_DRIFT_MODEL=
# USER_FRUSTRATION_MODEL=
# CONFUSION_LOOP_MODEL=
# SYCOPHANCY_SIGNAL_MODEL=
# Port for the semantic worker's /metrics, /ready and /health (default: 9103)
# METRICS_PORT=9103

# External evaluation integrations worker (Langfuse / LangSmith / Braintrust)
# See docs/integrations/external-evaluation.md. OFF by default.
# INTEGRATIONS_WORKER_ENABLED=false
# Port for this worker's /metrics, /ready and /health (default: 9104). Its own
# name, not METRICS_PORT: the elevenlabs worker shares this image and config.
# INTEGRATIONS_METRICS_PORT=9104

# ElevenLabs voice-call ingestion worker
# See docs/integrations/elevenlabs.md. OFF by default.
# ELEVENLABS_WORKER_ENABLED=false
# Port for this worker's /metrics, /ready and /health (default: 9105)
# ELEVENLABS_METRICS_PORT=9105

# Which provider the Customer API's OWN LLM features use (native explain's root
# cause, fix diff generation, custom-detector translation, issue summarisation):
# anthropic | openai | mistral. Unset = first key configured wins, anthropic
# first, which is the historical behaviour. Set it to keep this text inside one
# provider. Distinct from SEMANTIC_LLM_PROVIDER, which selects a different
# service's evaluators. See docs/integrations/mistral.md.
# API_LLM_PROVIDER=

# Encryption key for stored integration credentials. Required by the
# integrations and elevenlabs workers, and must match the Customer API's
# value exactly (it encrypts what those workers decrypt).
# DUNETRACE_MASTER_KEY=

# OpenTelemetry export (optional, see docs/integrations/opentelemetry.md)
# Ship Dunetrace runs as OTel spans to any OTLP backend (Datadog, Grafana,
# Honeycomb, Signoz, ...). Opt-in. Read by BOTH the SDK and the detector service
# (the detector service emits the signal/policy spans), so set these in both.
# DUNETRACE_OTEL_ENABLED=true
# DUNETRACE_OTEL_ENDPOINT=http://localhost:4317
# DUNETRACE_OTEL_PROTOCOL=grpc                     # grpc | http/protobuf
# Auth headers as k=v,k=v (e.g. DD-API-KEY=xxx). Comma-separated.
# DUNETRACE_OTEL_HEADERS=
# DUNETRACE_OTEL_SERVICE_NAME=dunetrace
# DUNETRACE_OTEL_SAMPLING_RATIO=1.0                # head sampling, 0.0 to 1.0
# Set false to drop content (tool args, request URLs, retrieval queries)
# DUNETRACE_OTEL_CAPTURE_CONTENT=true
# Optional dunetrace.org_id resource label (org is authoritative server-side)
# DUNETRACE_ORG_ID=

# OTel backend harness credentials (otel/docker-compose.yml collector fan-out)
# Datadog:
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com                            # datadoghq.eu for the EU region
# Grafana Cloud OTLP gateway (endpoint + basic-auth header, values URL-encoded):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceID:token>

# Alerts service (leave blank to run with no destinations)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_CHANNEL=#agent-alerts
# SLACK_MIN_SEVERITY=HIGH           # options: LOW | MEDIUM | HIGH | CRITICAL (default: HIGH)
# WEBHOOK_URL=https://your-endpoint.example.com/alerts
# WEBHOOK_SECRET=your-hmac-secret
# URL used in Slack alert "View Run" links — set to your dashboard address
# DASHBOARD_URL=http://localhost:3000
# Path to the same detectors.yml, read by the ALERTS service for each
# detector's alert_policy block (distinct from the detector service's
# DETECTOR_CONFIG above — same file, two different env vars)
# DETECTORS_YML=/app/detectors.yml
# Suppress duplicate alerts for the same (agent, failure_type) within N seconds (default: 3600)
# ALERT_DEDUP_WINDOW=3600
# Max delivery attempts before giving up (default: 3)
# MAX_RETRIES=3
# Backoff multiplier between retries in seconds (default: 2.0)
# RETRY_BACKOFF=2.0
# How long an alerts worker's claim on a signal stays valid, in seconds
# (default: 300). Claiming is what makes a second alerts replica safe — see
# docs/architecture.md's "Alerts worker: sharding plus claiming". Must exceed
# the worst-case delivery time for one batch, or a slow-but-alive worker's rows
# get stolen and the same alert is delivered twice.
# CLAIM_TIMEOUT_SECS=300
# Shard the alerts worker independently of the detector. Without these it reads
# the shared SHARD_COUNT/SHARD_INDEX above — so if you scale the detector to N
# replicas but run ONE alerts worker, set ALERTS_SHARD_COUNT=1 or that worker
# will only alert on agents hashing to bucket 0 and the rest go undelivered.
# ALERTS_SHARD_COUNT=1
# ALERTS_SHARD_INDEX=0
# Weekly digest (Monday 9am UTC). Set DIGEST_ENABLED=true to enable.
# DIGEST_ENABLED=false
# Digest day of week: 0=Monday … 6=Sunday (default: 0)
# DIGEST_DAY=0
# Digest hour in UTC (default: 9)
# DIGEST_HOUR=9
# Port for the alerts worker's /metrics, /ready and /health (default: 9102)
# METRICS_PORT=9102

# Customer API
# Max results per page (default: 50)
# PAGE_SIZE_DEFAULT=50
# Hard cap on page size (default: 500)
# PAGE_SIZE_MAX=500
# Requests-per-minute stamped on newly minted API keys (default: 600)
# DEFAULT_KEY_RATE_LIMIT_RPM=600
# Secret for validating signed remote policy payloads (leave blank in dev).
# Must equal the agent's DUNETRACE_POLICY_SECRET. Until this is set, a remote
# policy asking for stop / require_approval / escalate_to_human / switch_model /
# inject is downgraded to log-only — see docs/policies.md.
# POLICY_SIGNING_SECRET=
# Signing secret for Slack interactive payloads (App Settings > Basic
# Information). REQUIRED in production for the interactive buttons — Mark
# resolved / Not a problem / Snooze on alerts, and Approve / Deny on approvals.
# POST /v1/slack/callback is mounted WITHOUT the API-key dependency every other
# route carries and takes its org_id from the payload, so the Slack signature is
# the only credential on it. Without this set, the callback is refused with 403
# outside AUTH_MODE=dev, rather than trusting an unverifiable POST.
# SLACK_SIGNING_SECRET=

# LLM for explain endpoint (Anthropic preferred; falls back to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# GitHub integration — enables "Open PR" fix path
# Legacy single-repo path (fallback when no per-org GitHub App installation exists):
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/repo
# GITHUB_BASE_BRANCH=main

# Per-org GitHub App (recommended — see docs/integrations/github-app.md):
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_SLUG=your-app-slug

# SDK examples (optional)
# OPENAI_API_KEY=sk-...
