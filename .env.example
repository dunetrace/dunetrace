# Copy this file to .env and fill in your values.
# docker compose will load .env automatically.

# Shared
DATABASE_URL=postgresql://dunetrace:dunetrace@postgres:5432/dunetrace
LOG_LEVEL=INFO

# Ingest service
# AUTH_MODE: dev (no API key needed) | prod (requires api_keys table entries)
# The services default to `prod` when this is unset — dev mode disables auth
# entirely, so it is always an explicit opt-in. Keep `dev` for local Docker;
# set `prod` (and create keys via POST /v1/keys) before exposing any port.
AUTH_MODE=dev
# Admin key for POST /v1/keys (generate API keys). Leave blank to disable.
# ADMIN_API_KEY=
# Token for internal service-to-service calls (leave blank in dev)
# INTERNAL_TOKEN=
# Per-IP rate limit: requests per minute (default: 60)
# RATE_LIMIT_REQUESTS=60
# Global rate limit across all IPs: requests per minute (default: 600)
# RATE_LIMIT_RPM=600
# Max events per ingest batch (default: 500)
# MAX_BATCH_SIZE=500

# Detector service
# Seconds between detector poll cycles (default: 5)
POLL_INTERVAL=5
# Treat runs with no new events for N seconds as stalled (default: 90)
STALL_TIMEOUT_SECS=90
# Runs processed per poll cycle (default: 100)
BATCH_SIZE=100
# Parallel run-processing goroutines (default: 8)
# DETECTOR_CONCURRENCY=8
# Horizontal sharding: total shard count (default: 1 = no sharding).
# Applies to BOTH the detector and the alerts worker — same scheme, same names.
# SHARD_COUNT=1
# This replica's shard index, 0-based (default: 0)
# SHARD_INDEX=0
# Re-scan overlap for the detector's poll watermark, in seconds (default: 3600).
# The watermark is what bounds run discovery to recent events instead of the whole
# retention window. Must be >= STALL_TIMEOUT_SECS or the worker refuses to start.
# See docs/architecture.md's "Poll watermark".
# WATERMARK_GRACE_SECS=3600
# Path to detector threshold overrides, read by the DETECTOR service
# (default: /app/detectors.yml — where docker-compose mounts it)
# DETECTOR_CONFIG=/app/detectors.yml
# Directory scanned at startup for Python-class custom detectors
# (default: ~/.dunetrace/detectors/ — see docs/detectors.md)
# DUNETRACE_CUSTOM_DETECTORS_PATH=~/.dunetrace/detectors

# Event retention (ingest service)
# Drop event partitions older than N days. Runs at startup then daily.
# See docs/operations.md. Default 90.
# EVENT_RETENTION_DAYS=90

# processed_runs retention (detector service)
# Age bound on the daily prune scan (default: 120). Rows are only deleted once
# the run's events are already gone, so this is a scan bound, not the safety
# mechanism — keep it beyond EVENT_RETENTION_DAYS. See docs/operations.md.
# PROCESSED_RUNS_RETENTION_DAYS=120
# Rows per delete batch (default: 10000)
# PRUNE_BATCH_SIZE=10000

# Semantic evaluation worker (Tier 2, LLM-based — OFF by default)
# See docs/semantic-evaluation.md. Requires an LLM key below.
# SEMANTIC_WORKER_ENABLED=false
# Which provider the evaluators build by default: openai | anthropic
# SEMANTIC_LLM_PROVIDER=openai
# Per-evaluator model override. Blank = the provider's cost-conscious default.
# HALLUCINATION_MODEL=
# TASK_COMPLETION_MODEL=
# TASK_UNDERSTANDING_FAILURE_MODEL=
# OFF_TOPIC_DRIFT_MODEL=
# USER_FRUSTRATION_MODEL=
# CONFUSION_LOOP_MODEL=
# SYCOPHANCY_SIGNAL_MODEL=

# External evaluation integrations worker (Langfuse / LangSmith / Braintrust)
# See docs/integrations/external-evaluation.md. OFF by default.
# INTEGRATIONS_WORKER_ENABLED=false

# ElevenLabs voice-call ingestion worker
# See docs/integrations/elevenlabs.md. OFF by default.
# ELEVENLABS_WORKER_ENABLED=false

# Encryption key for stored integration credentials. Required by the
# integrations and elevenlabs workers, and must match the Customer API's
# value exactly (it encrypts what those workers decrypt).
# DUNETRACE_MASTER_KEY=

# OpenTelemetry export (optional, see docs/integrations/opentelemetry.md)
# Ship Dunetrace runs as OTel spans to any OTLP backend (Datadog, Grafana,
# Honeycomb, Signoz, ...). Opt-in. Read by BOTH the SDK and the detector service
# (the detector service emits the signal/policy spans), so set these in both.
# DUNETRACE_OTEL_ENABLED=true
# DUNETRACE_OTEL_ENDPOINT=http://localhost:4317
# DUNETRACE_OTEL_PROTOCOL=grpc                     # grpc | http/protobuf
# Auth headers as k=v,k=v (e.g. DD-API-KEY=xxx). Comma-separated.
# DUNETRACE_OTEL_HEADERS=
# DUNETRACE_OTEL_SERVICE_NAME=dunetrace
# DUNETRACE_OTEL_SAMPLING_RATIO=1.0                # head sampling, 0.0 to 1.0
# Set false to drop content (tool args, request URLs, retrieval queries)
# DUNETRACE_OTEL_CAPTURE_CONTENT=true
# Optional dunetrace.org_id resource label (org is authoritative server-side)
# DUNETRACE_ORG_ID=

# OTel backend harness credentials (otel/docker-compose.yml collector fan-out)
# Datadog:
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com                            # datadoghq.eu for the EU region
# Grafana Cloud OTLP gateway (endpoint + basic-auth header, values URL-encoded):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceID:token>

# Alerts service (leave blank to run with no destinations)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_CHANNEL=#agent-alerts
# SLACK_MIN_SEVERITY=HIGH           # options: LOW | MEDIUM | HIGH | CRITICAL (default: HIGH)
# WEBHOOK_URL=https://your-endpoint.example.com/alerts
# WEBHOOK_SECRET=your-hmac-secret
# URL used in Slack alert "View Run" links — set to your dashboard address
# DASHBOARD_URL=http://localhost:3000
# Path to the same detectors.yml, read by the ALERTS service for each
# detector's alert_policy block (distinct from the detector service's
# DETECTOR_CONFIG above — same file, two different env vars)
# DETECTORS_YML=/app/detectors.yml
# Suppress duplicate alerts for the same (agent, failure_type) within N seconds (default: 3600)
# ALERT_DEDUP_WINDOW=3600
# Max delivery attempts before giving up (default: 3)
# MAX_RETRIES=3
# Backoff multiplier between retries in seconds (default: 2.0)
# RETRY_BACKOFF=2.0
# How long an alerts worker's claim on a signal stays valid, in seconds
# (default: 300). Claiming is what makes a second alerts replica safe — see
# docs/architecture.md's "Alerts worker: sharding plus claiming". Must exceed
# the worst-case delivery time for one batch, or a slow-but-alive worker's rows
# get stolen and the same alert is delivered twice.
# CLAIM_TIMEOUT_SECS=300
# Shard the alerts worker independently of the detector. Without these it reads
# the shared SHARD_COUNT/SHARD_INDEX above — so if you scale the detector to N
# replicas but run ONE alerts worker, set ALERTS_SHARD_COUNT=1 or that worker
# will only alert on agents hashing to bucket 0 and the rest go undelivered.
# ALERTS_SHARD_COUNT=1
# ALERTS_SHARD_INDEX=0
# Weekly digest (Monday 9am UTC). Set DIGEST_ENABLED=true to enable.
# DIGEST_ENABLED=false
# Digest day of week: 0=Monday … 6=Sunday (default: 0)
# DIGEST_DAY=0
# Digest hour in UTC (default: 9)
# DIGEST_HOUR=9

# Customer API
# Max results per page (default: 50)
# PAGE_SIZE_DEFAULT=50
# Hard cap on page size (default: 500)
# PAGE_SIZE_MAX=500
# Secret for validating signed policy payloads (leave blank in dev)
# POLICY_SIGNING_SECRET=
# Signing secret for Slack interactive payloads
# SLACK_SIGNING_SECRET=

# LLM for explain endpoint (Anthropic preferred; falls back to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# GitHub integration — enables "Open PR" fix path
# Legacy single-repo path (fallback when no per-org GitHub App installation exists):
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/repo
# GITHUB_BASE_BRANCH=main

# Per-org GitHub App (recommended — see docs/integrations/github-app.md):
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_SLUG=your-app-slug

# SDK examples (optional)
# OPENAI_API_KEY=sk-...
